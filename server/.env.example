DATABASE_URL="mysql://db_user:db_password@localhost:3306/db_name"

PORT=4000
NODE_ENV=development

# Admin frontend origin allowed to call this API (comma-separated for multiple)
CLIENT_ORIGIN="http://localhost:5173"

# Public Client Bill Check Portal origin (Fase 9) — separate origin, no cookies
CEK_CLIENT_ORIGIN="http://localhost:5174"

# Change this to a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
AUTH_COOKIE_NAME="wonderland_admin_token"

# Used only by prisma/seed.ts to create the first admin account
SEED_ADMIN_NAME="Admin Wonderland"
SEED_ADMIN_EMAIL="admin@wonderlandtravel.id"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Optional — fill all three to enable Cloudinary uploads.
# Leave blank to use local disk storage (server/uploads) instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
