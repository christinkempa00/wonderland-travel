generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model PaketWisata {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  location    String
  duration    String
  price       Int
  rating      Float               @default(5)
  tag         String?
  description String              @db.Text
  highlights  Json
  active      Boolean             @default(true)
  order       Int                 @default(0)
  images      PaketWisataImage[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("paket_wisata")
}

model PaketWisataImage {
  id            String      @id @default(cuid())
  paketWisataId String
  paketWisata   PaketWisata @relation(fields: [paketWisataId], references: [id], onDelete: Cascade)
  url           String
  publicId      String
  order         Int         @default(0)
  createdAt     DateTime    @default(now())

  @@map("paket_wisata_images")
}

enum ReservasiJenis {
  PAKET_WISATA
  HOTEL
  PESAWAT
  RENTAL
  GABUNGAN
}

enum ReservasiStatus {
  BARU_MASUK
  DIKONFIRMASI
  MENUNGGU_PEMBAYARAN
  DIBAYAR_SEBAGIAN
  LUNAS
  SELESAI
  DIBATALKAN
}

enum ReservasiSumber {
  WEBSITE_EXPLORE
  WEBSITE_KONTAK
  MANUAL_STAF
  WHATSAPP
}

enum StatusBayar {
  BELUM_BAYAR
  SEBAGIAN
  LUNAS
}

enum MetodePembayaran {
  TRANSFER_BANK
  E_WALLET
  KARTU_KREDIT
  TUNAI
  LAINNYA
}

model Pelanggan {
  id        String      @id @default(cuid())
  kodeKlien String      @unique
  nama      String
  noHp      String
  email     String?
  alamat    String?     @db.Text
  reservasi Reservasi[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("pelanggan")
}

model Reservasi {
  id             String          @id @default(cuid())
  nomorBooking   String          @unique
  pelangganId    String
  pelanggan      Pelanggan       @relation(fields: [pelangganId], references: [id])
  jenis          ReservasiJenis
  itemRingkasan  Json
  tanggalMulai   DateTime
  tanggalSelesai DateTime?
  status         ReservasiStatus @default(BARU_MASUK)
  sumber         ReservasiSumber @default(MANUAL_STAF)
  catatan        String?         @db.Text
  invoice        Invoice?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("reservasi")
}

model Invoice {
  id           String        @id @default(cuid())
  nomorInvoice String        @unique
  reservasiId  String        @unique
  reservasi    Reservasi     @relation(fields: [reservasiId], references: [id])
  items        InvoiceItem[]
  diskon       Int           @default(0)
  jatuhTempo   DateTime
  statusBayar  StatusBayar   @default(BELUM_BAYAR)
  pembayaran   Pembayaran[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("invoice")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  nama        String
  qty         Int     @default(1)
  hargaSatuan Int
  order       Int     @default(0)

  @@map("invoice_items")
}

model Pembayaran {
  id            String           @id @default(cuid())
  invoiceId     String
  invoice       Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  jumlah        Int
  metode        MetodePembayaran
  buktiUrl      String?
  buktiPublicId String?
  tanggal       DateTime
  catatan       String?
  createdAt     DateTime         @default(now())

  @@map("pembayaran")
}

model Notifikasi {
  id          String   @id @default(cuid())
  pesan       String
  reservasiId String?
  dibaca      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("notifikasi")
}
