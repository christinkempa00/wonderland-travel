# Next.js static export (output: "export") di Apache/LiteSpeed (Hostinger).
#
# Next.js menghasilkan "paket-wisata.html" DAN folder "paket-wisata/" (isinya
# payload RSC untuk client-side navigation, BUKAN halaman, jadi tidak ada
# index.html di dalamnya). Tanpa aturan di bawah, request ke "/paket-wisata"
# nyasar ke folder itu -> 403 karena folder itu tidak punya index.html dan
# directory listing dimatikan.
#
# Route halaman di-map eksplisit ke file ".html"-nya lewat RewriteRule di
# bawah, dengan pola "nama/?$" (slash di akhir opsional) — jadi cocok baik
# untuk "/paket-wisata" MAUPUN "/paket-wisata/" sekaligus, tanpa bergantung
# pada perilaku auto-redirect direktori bawaan server (yang di LiteSpeed
# Hostinger tidak bisa dimatikan lewat "DirectorySlash Off" ala Apache biasa).
#
# PENTING: kalau ada halaman baru ditambahkan ke src/app/, tambahkan juga
# satu baris RewriteRule untuk nama route-nya di bawah.

DirectoryIndex index.html
Options -Indexes +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^paket-wisata/?$ /paket-wisata.html [L]
  RewriteRule ^explore/?$ /explore.html [L]
  RewriteRule ^galeri/?$ /galeri.html [L]
  RewriteRule ^kontak/?$ /kontak.html [L]

  # Fallback generik (jaga-jaga untuk route yang lupa ditambahkan di atas),
  # berlaku kalau server mendukung resolusi REQUEST_FILENAME dengan benar.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*[^/])$ /$1.html [L]
</IfModule>

# Path yang sama sekali tidak cocok file/folder apa pun (bukan hasil rewrite
# di atas) jatuh ke sini lewat mekanisme 404 bawaan server — supaya status
# HTTP-nya benar 404 (bukan 200) sambil tetap menampilkan halaman custom.
ErrorDocument 404 /404.html
